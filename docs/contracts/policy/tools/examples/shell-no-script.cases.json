[
  {
    "name": "argv",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls",
          "-la"
        ]
      }
    },
    "allow": true
  },
  {
    "name": "argv with every option",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "make"
        ],
        "cwd": "/home/browser/work",
        "env": {
          "CI": "1"
        },
        "stdin": "",
        "timeout_ms": 600000,
        "max_output_bytes": 4194304,
        "background": true
      }
    },
    "allow": true
  },
  {
    "name": "the browser tool",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "url"
          }
        ]
      }
    },
    "allow": true
  },
  {
    "name": "the desktop tool",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "desktop_execute",
      "arguments": {
        "operations": [
          {
            "type": "screen.grab"
          }
        ]
      }
    },
    "allow": true
  },
  {
    "name": "poll a background command",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_process",
      "arguments": {
        "action": "poll",
        "id": "p1"
      }
    },
    "allow": true
  },
  {
    "name": "script form",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "script": "ls -la"
      }
    },
    "allow": false
  },
  {
    "name": "argv and script together",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls"
        ],
        "script": "id"
      }
    },
    "allow": false
  },
  {
    "name": "argv and an empty script",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls"
        ],
        "script": ""
      }
    },
    "allow": false
  },
  {
    "name": "argv and script: null",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls"
        ],
        "script": null
      }
    },
    "allow": false
  },
  {
    "name": "argv and script: false",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls"
        ],
        "script": false
      }
    },
    "allow": false
  },
  {
    "name": "argv is a string",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": "ls -la"
      }
    },
    "allow": false
  },
  {
    "name": "a shell as the program (a rule about form does not restrict what runs)",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "bash",
          "-c",
          "ls -la | wc -l"
        ]
      }
    },
    "allow": true
  },
  {
    "name": "null arguments",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": null
    },
    "allow": false
  },
  {
    "name": "no arguments at all",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {}
    },
    "allow": false
  },
  {
    "name": "arguments is an array",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": [
        [
          "ls"
        ]
      ]
    },
    "allow": false
  },
  {
    "name": "another server's shell_execute",
    "input": {
      "operation": "mcp_call_tool",
      "server": "other",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls"
        ]
      }
    },
    "allow": false
  },
  {
    "name": "a tool with a similar name",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute2",
      "arguments": {
        "argv": [
          "ls"
        ]
      }
    },
    "allow": false
  }
]
