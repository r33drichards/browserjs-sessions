[
  {
    "name": "one URL on the list",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "cmd": "curl -q 'https://api.github.com/repos/octocat/Hello-World'",
        "timeout": 60
      }
    },
    "allow": true,
    "shell": {
      "command": "curl -q 'https://api.github.com/repos/octocat/Hello-World'",
      "argv": [
        "curl",
        "-q",
        "https://api.github.com/repos/octocat/Hello-World"
      ]
    }
  },
  {
