[
  {
    "name": "git status",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "git",
          "status"
        ]
      }
    },
    "allow": true
  },
  {
    "name": "git clone, in a directory, in the background",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "git",
          "clone",
          "https://github.com/octocat/Hello-World"
        ],
        "cwd": "/home/browser/work",
        "background": true,
        "timeout_ms": 600000
      }
    },
    "allow": true
  },
  {
    "name": "ls with flags and a path",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls",
          "-la",
          "/data/chrome/Downloads"
        ]
      }
    },
    "allow": true
  },
  {
    "name": "ls alone",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls"
        ]
      }
    },
    "allow": true
  },
  {
    "name": "poll a background command",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
