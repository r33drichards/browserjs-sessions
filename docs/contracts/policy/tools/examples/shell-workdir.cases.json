[
  {
    "name": "argv in the directory",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "ls",
          "-la"
        ],
        "cwd": "/home/browser/work"
      }
    },
    "allow": true
  },
  {
    "name": "script in a subdirectory",
