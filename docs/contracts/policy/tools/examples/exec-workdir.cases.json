[
  {
    "name": "a command in the directory",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "cmd": "cd /home/browser/work && ls -la",
        "timeout": 60
      }
    },
    "allow": true,
    "shell": {
      "command": "ls -la",
      "argv": [
        "ls",
        "-la"
      ]
    }
  },
  {
    "name": "in a subdirectory",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "cmd": "cd /home/browser/work/app/packages/a && npm test",
        "timeout": 1800
      }
    },
    "allow": true,
    "shell": {
      "command": "npm test",
      "argv": [
        "npm",
        "test"
      ]
    }
  },
  {
    "name": "a directory with a dot and a dash",
