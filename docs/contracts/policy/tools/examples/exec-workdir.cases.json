  {
    "name": "read the output",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "stream_logs",
      "arguments": {
        "id": "215e7d1d-cc35-47ac-8fd1-e018fd03d2b9",
        "offset": 0
      }
    },
    "allow": true
  },
  {
    "name": "search the output",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "search_logs",
      "arguments": {
        "id": "215e7d1d-cc35-47ac-8fd1-e018fd03d2b9",
        "pattern": "(?i)error"
      }
    },
    "allow": true
  },
