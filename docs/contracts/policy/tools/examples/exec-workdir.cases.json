[
  {
    "name": "a command in the directory",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "ls",
        "args": [
          "-la"
        ],
        "timeout": 60,
        "cwd": "/data/chrome/home/work"
      }
    },
    "allow": true
  },
  {
    "name": "in a subdirectory, with the longest timeout",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "npm",
        "args": [
          "test"
        ],
        "timeout": 1800,
        "cwd": "/data/chrome/home/work/app/packages/a"
      }
    },
    "allow": true
  },
