[
  {
    "name": "one URL on the list",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "curl",
          "-q",
          "https://api.github.com/repos/octocat/Hello-World"
        ]
      }
    },
    "allow": true
  },
  {
    "name": "flags and a URL",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "shell_execute",
      "arguments": {
        "argv": [
          "curl",
          "-q",
          "--fail",
          "-s",
          "https://example.com/"
        ],
        "timeout_ms": 10000
      }
    },
    "allow": true
  },
  {
    "name": "host with no path",
