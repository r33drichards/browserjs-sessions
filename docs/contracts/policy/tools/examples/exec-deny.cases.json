[
  {
    "name": "the browser tool",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "url"
          }
        ]
      }
    },
    "allow": true
  },
  {
    "name": "a command",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "ls",
        "timeout": 60
      }
    },
    "allow": false
  },
  {
    "name": "a command with arguments and a short timeout",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "true",
        "args": [],
        "timeout": 1
      }
    },
    "allow": false
  },
  {
    "name": "read the output",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "stream_logs",
      "arguments": {
        "id": "215e7d1d-cc35-47ac-8fd1-e018fd03d2b9",
        "offset": 0
      }
    },
    "allow": false
  },
  {
    "name": "search the output",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "search_logs",
      "arguments": {
        "id": "215e7d1d-cc35-47ac-8fd1-e018fd03d2b9",
        "pattern": "(?i)error"
      }
    },
    "allow": false
  },
  {
    "name": "stop a command",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "kill",
      "arguments": {
        "id": "215e7d1d-cc35-47ac-8fd1-e018fd03d2b9"
      }
    },
    "allow": false
  },
  {
    "name": "the desktop tool (it can type into a terminal)",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "desktop_execute",
      "arguments": {
        "operations": [
          {
            "type": "screen.grab"
          }
        ]
      }
    },
    "allow": false
  },
  {
    "name": "another server's browser_execute",
    "input": {
      "operation": "mcp_call_tool",
      "server": "other",
      "tool": "browser_execute",
      "arguments": {
        "operations": []
      }
    },
    "allow": false
  },
  {
    "name": "null arguments",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": null
    },
    "allow": false
  },
  {
    "name": "no arguments at all",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {}
    },
    "allow": false
  },
  {
    "name": "arguments is an array",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": [
        {
          "bin": "ls",
          "timeout": 60
        }
      ]
    },
    "allow": false
  },
  {
    "name": "no bin",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "timeout": 60
      }
    },
    "allow": false
  },
  {
    "name": "bin is an array",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
