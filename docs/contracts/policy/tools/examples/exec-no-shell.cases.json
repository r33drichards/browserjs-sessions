[
  {
    "name": "a program and arguments",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "ls",
        "args": [
          "-la",
          "/data/chrome/Downloads"
        ],
        "timeout": 60
      }
    },
    "allow": true
  },
  {
    "name": "a program alone, args left out",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "uptime",
        "timeout": 60
      }
    },
    "allow": true
  },
  {
    "name": "a program by path, in a directory",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "/data/chrome/home/work/app/build.sh",
        "args": [
          "--release"
        ],
        "timeout": 60,
        "cwd": "/data/chrome/home/work/app"
      }
    },
    "allow": true
  },
  {
    "name": "no upper limit on the timeout in this policy",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "make",
        "args": [
          "all"
        ],
        "timeout": 86400,
        "cwd": "/data/chrome/home/work/app"
      }
    },
    "allow": true
  },
  {
    "name": "shell syntax as an argument is only text",
    "input": {
      "operation": "mcp_call_tool",
      "server": "exec",
      "tool": "exec",
      "arguments": {
        "bin": "echo",
        "args": [
          "$(id); rm -rf ~ | sh"
        ],
        "timeout": 60
      }
    },
    "allow": true
  },
  {
    "name": "the browser tool",
