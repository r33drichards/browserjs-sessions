      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "click",
            "params": {
              "selector": "a"
            }
          },
          {
            "type": "evaluate",
            "params": {
              "script": "1"
            }
          },
          {
            "type": "screenshot",
            "params": {}
          }
        ]
      }
    },
    "allow": false
  },
  {
