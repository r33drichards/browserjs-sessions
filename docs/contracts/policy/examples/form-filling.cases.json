  {
    "name": "a form",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "navigate",
            "params": {
              "url": "https://forms.example.org/apply"
            }
          },
          {
            "type": "setViewport",
            "params": {
              "width": 1280,
              "height": 800
            }
          },
          {
            "type": "type",
            "params": {
              "selector": "#name",
              "text": "Ada Lovelace"
            }
          },
          {
            "type": "press",
            "params": {
              "key": "Tab"
            }
          },
          {
            "type": "select",
            "params": {
              "selector": "#c",
              "values": [
                "uk"
              ]
            }
          },
          {
            "type": "press",
            "params": {
              "key": "Enter"
            }
          }
        ]
      }
    },
    "allow": true
  },
