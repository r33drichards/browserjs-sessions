    "allow": false
  },
  {
    "name": "https page, wait, screenshot",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "navigate",
            "params": {
              "url": "https://news.example.net/today?x=1"
            }
          },
          {
            "type": "wait",
            "params": {
              "ms": 500
            }
          },
          {
            "type": "screenshot",
            "params": {
              "fullPage": true
            }
          }
        ]
      }
    },
    "allow": true
  },
  {
    "name": "http is refused",
    "input": {
      "operation": "mcp_call_tool",
