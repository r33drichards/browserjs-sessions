[
  {
    "name": "empty pipeline",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": []
      }
    },
    "allow": true
  },
  {
    "name": "null arguments",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": null
    },
    "allow": false
  },
  {
    "name": "operations is not an array",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": "x"
      }
    },
    "allow": false
  },
  {
    "name": "another server",
    "input": {
      "operation": "mcp_call_tool",
      "server": "other",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "click",
            "params": {
              "selector": "a"
            }
          }
        ]
      }
    },
    "allow": false
  },
  {
    "name": "another tool",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "other_tool",
      "arguments": {
        "operations": [
          {
            "type": "click",
            "params": {
              "selector": "a"
            }
          }
        ]
      }
    },
    "allow": false
  },
  {
    "name": "operation without a type",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "params": {}
          }
        ]
      }
    },
    "allow": false
  },
  {
    "name": "unknown operation type",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "download",
            "params": {}
          }
        ]
      }
    },
    "allow": false
  },
  {
    "name": "every operation",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "navigate",
            "params": {
              "url": "http://anything.test/"
            }
          },
          {
            "type": "evaluate",
            "params": {
              "script": "1"
            }
          },
          {
            "type": "setContent",
            "params": {
              "html": "<p>"
            }
          },
          {
            "type": "type",
            "params": {
              "selector": "#q",
              "text": ""
            }
          },
          {
            "type": "url",
            "params": {}
          }
        ]
      }
    },
    "allow": true
  },
  {
    "name": "tab and close are not constrained",
    "input": {
      "operation": "mcp_call_tool",
      "server": "browser",
      "tool": "browser_execute",
      "arguments": {
        "operations": [
          {
            "type": "click",
            "params": {
              "selector": "a"
            }
          }
        ],
        "tab": "work",
        "close": true
      }
    },
    "allow": true
  }
]
