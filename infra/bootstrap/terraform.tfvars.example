# Copy to terraform.tfvars (which git ignores) and edit.

# Globally unique and permanent. "browserjs-sessions" plus a short suffix:
#   echo "browserjs-sessions-$(openssl rand -hex 2)"
project_id = "browserjs-sessions-xxxx"

# --- Either: use a project you created by hand (console or gcloud), with
# billing already attached.
create_project = false

# --- Or: let OpenTofu create it.
# create_project  = true
# billing_account = "01ABCD-234567-89EF01"
# org_id          = "123456789012" # or folder_id; omit both for a personal account

region = "us-west1"

# Optional e-mail alerts at 50 %, 90 % and 100 % of this many USD per month.
# Needs billing_account and roles/billing.costsManager on that account.
# budget_amount   = 300
# billing_account = "01ABCD-234567-89EF01"
