# syntax=docker/dockerfile:1
# Opt-in skills image. The normal Dockerfile and production pins stay unchanged.
# The feature branch is codex/user-supplied-skills; build its reviewed commit.
FROM rust:trixie AS builder
ARG MCP_JS_COMMIT=df7ff14823861941bfe1d9f245a39c045a243e86
RUN apt-get update && apt-get install -y --no-install-recommends git python3 pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git init && git remote add origin https://github.com/r33drichards/mcp-js.git \
    && git fetch --depth 1 origin "$MCP_JS_COMMIT" && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$MCP_JS_COMMIT"
RUN cargo build --locked --release -p server && cp target/release/server /mcp-v8

FROM python:3.13-slim AS documentation
COPY images/mcp-js/skills/ /skills/
COPY docs/ /skills/project-documentation/references/docs/
COPY site/reference/ /skills/project-documentation/references/site/
COPY README.md /skills/project-documentation/references/README.md
COPY images/mcp-js/prepare-skills.py /prepare-skills.py
RUN python3 /prepare-skills.py /skills

FROM wholelottahoopla/mcp-js@sha256:abd34e6c3f347914fbc3be454dd18868d290b8564ae7dd5bf778cb2bd4ad5a84
COPY --from=builder --chmod=755 /mcp-v8 /usr/local/bin/mcp-v8
COPY images/mcp-js/mcp_tools.rego images/mcp-js/filesystem.rego images/mcp-js/mcp-servers.json images/mcp-js/mcp-servers.no-exec.json images/mcp-js/run_js.md images/mcp-js/instructions.md /etc/mcp/
COPY --chmod=755 images/mcp-js/start.sh /usr/local/bin/start.sh
COPY --from=documentation /skills/ /etc/mcp/skills/
ENV MCP_V8_HTTP_PORT=8080 \
    MCP_V8_HEAP_STORE=none \
    MCP_V8_MCP_CONFIG=/etc/mcp/mcp-servers.json \
    MCP_V8_POLICIES_JSON='{"mcp_tools":{"policies":[{"url":"file:///etc/mcp/mcp_tools.rego"}]},"filesystem":{"policies":[{"url":"file:///etc/mcp/filesystem.rego"}]}}' \
    MCP_V8_RUN_JS_DESCRIPTION=@/etc/mcp/run_js.md \
    MCP_V8_INSTRUCTIONS=@/etc/mcp/instructions.md \
    MCP_V8_SESSION_DB_PATH=/data/mcp/sessions \
    MCP_V8_SKILLS_DIR=/etc/mcp/skills
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/start.sh"]
