<?xml version="1.0" encoding="UTF-8"?>
<!--
  Everything not set here keeps openbox's built-in default (click to focus,
  Alt+Tab, Alt+F4): without a config file openbox ran on those alone.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktops>
    <number>1</number>
  </desktops>
  <applications>
    <!--
      Every ordinary window (Chromium's main window, a tab dragged out, a
      popup a page opens, DevTools) is maximised when it appears, whatever
      size it asks for: Chromium's own start-maximized flag does not hold for
      a window it restores from the last session. openbox refits a maximised
      window whenever the desktop changes size, which is what makes the
      browser follow the viewer; a window that is merely as large as the
      desktop was is left alone.

      Dialogs (file chooser, print) are another window type and keep their
      size, and openbox drops the maximising for a window that cannot be
      resized.
    -->
    <application type="normal">
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
