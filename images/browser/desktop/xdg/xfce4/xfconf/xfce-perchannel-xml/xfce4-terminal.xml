<?xml version="1.0" encoding="UTF-8"?>
<!--
  The terminal's font, named: the image's fontconfig does not resolve the
  generic "Monospace" to a fixed-width font, and a terminal drawn with a
  proportional one spaces its letters a cell and a half apart.
-->
<channel name="xfce4-terminal" version="1.0">
  <property name="font-use-system" type="bool" value="false"/>
  <property name="font-name" type="string" value="DejaVu Sans Mono 11"/>
</channel>
